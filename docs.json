{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "StoreRocket Docs",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A78BFA",
    "dark": "#6D28D9"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Widget",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "widget/introduction",
              "widget/installation",
              "widget/quick-start"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "widget/options",
              "widget/styling",
              "widget/localization"
            ]
          },
          {
            "group": "JavaScript API",
            "pages": [
              "widget/events",
              "widget/methods",
              "widget/callbacks"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "widget/spa-integration",
              "widget/custom-markers",
              "widget/filters"
            ]
          }
        ]
      },
      {
        "tab": "REST API",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api/introduction",
              "api/authentication",
              "api/errors"
            ]
          },
          {
            "group": "Locations",
            "pages": [
              "api/locations/list",
              "api/locations/get",
              "api/locations/create",
              "api/locations/update",
              "api/locations/delete"
            ]
          },
          {
            "group": "Filters",
            "pages": [
              "api/filters/list",
              "api/filters/create"
            ]
          },
          {
            "group": "Analytics",
            "pages": [
              "api/analytics/overview"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://app.storerocket.io",
          "icon": "rocket"
        },
        {
          "anchor": "Support",
          "href": "mailto:support@storerocket.io",
          "icon": "envelope"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Pricing",
        "href": "https://storerocket.io/pricing"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://app.storerocket.io/register"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/storerocket",
      "github": "https://github.com/storerocket"
    }
  }
}
