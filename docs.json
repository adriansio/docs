{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "StoreRocket",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A78BFA",
    "dark": "#6D28D9"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Help center",
        "href": "https://help.storerocket.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://storerocket.io/app/api-tokens"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": [
          "index",
          "api/quickstart",
          "api/introduction",
          "api/authentication",
          "api/errors"
        ]
      },
      {
        "group": "Integration guides",
        "pages": [
          "api/sync-locations"
        ]
      },
      {
        "group": "Account",
        "pages": [
          "api/user",
          "api/projects"
        ]
      },
      {
        "group": "Locations",
        "pages": [
          "api/locations/list",
          "api/locations/get",
          "api/locations/create",
          "api/locations/update",
          "api/locations/put",
          "api/locations/delete"
        ]
      },
      {
        "group": "Existing integrations",
        "pages": [
          "api/legacy",
          "api/legacy-locations",
          "api/legacy-leads"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/storerocket",
      "github": "https://github.com/adriansio/docs"
    }
  },
  "api": {
    "mdx": {
      "server": "https://storerocket.io",
      "auth": {
        "method": "bearer"
      }
    },
    "playground": {
      "display": "interactive",
      "proxy": false
    }
  },
  "redirects": [
    {
      "source": "/api",
      "destination": "/api/introduction"
    }
  ]
}
